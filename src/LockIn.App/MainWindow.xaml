<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LockIn.App.MainWindow" Title="LOCK-IN" Width="1100" Height="760" MinWidth="760" MinHeight="680" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen" Closing="Window_Closing" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LOCK—IN" FontSize="28" FontWeight="Black" />
                <TextBlock Text="Your computer, reduced to what the mission needs." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#151C26" CornerRadius="16" Padding="14,8">
                <TextBlock x:Name="HeaderStatusText" Text="READY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
            </Border>
        </Grid>
        <TabControl Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderThickness="0" Padding="0" x:Name="WorkspaceTabs">
            <TabItem Header="Session setup">
                <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="24" Margin="0,16,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="MISSION SETUP" FontWeight="Bold" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="What are you locking in for?" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,18" />
                            <TextBlock Text="Mission name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="MissionTextBox" Text="Deep work" FontSize="15" />
                            <TextBlock Text="Duration" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6" />
                            <ComboBox x:Name="DurationComboBox" SelectedIndex="1">
                                <ComboBoxItem Content="25 minutes" Tag="25" />
                                <ComboBoxItem Content="50 minutes" Tag="50" />
                                <ComboBoxItem Content="90 minutes" Tag="90" />
                                <ComboBoxItem Content="2 hours" Tag="120" />
                                <ComboBoxItem Content="3 hours" Tag="180" />
                                <ComboBoxItem Content="4 hours" Tag="240" />
                            </ComboBox>
                            <CheckBox x:Name="StrictModeCheckBox" Content="Strict Mode — no early exit inside LOCK-IN" />
                            <Border Background="#0D1118" CornerRadius="12" Padding="12" Margin="0,12,0,12">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12">
                                Strict Mode adds commitment friction; it does not disable Task Manager or Windows recovery.
                                The session always expires automatically at the chosen time.
                            </TextBlock>
                            </Border>
                            <Button x:Name="StartMissionButton" Content="START MISSION" Background="{StaticResource AccentBrush}" Foreground="#07110B" FontSize="15" Padding="18,13" Click="StartMissionButton_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <TabItem Header="Allowed applications">
                <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="28" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Tools for your next session" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Allowed apps" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6" />
                        <TextBlock Text="Pick the .exe files you genuinely need. Everything else with a normal desktop window is treated as a distraction." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />
                        <ListBox x:Name="AllowedAppsList" Height="120" />
                        <WrapPanel Margin="0,6,0,6">
                            <Button x:Name="AddAppButton" Content="+ Add application" Click="AddAppButton_Click" />
                            <Button x:Name="RemoveAppButton" Content="Remove selected" Click="RemoveAppButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Focus">
                <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="24" Margin="0,16,0,0" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid x:Name="IdlePanel">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="330">
                                <TextBlock Text="Ready when you are" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No active mission" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,8" />
                                <TextBlock Text="Open Session setup to choose a duration. Manage your allowed applications in their own workspace before starting." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ActivePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ActiveMissionText" Text="Deep work" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock x:Name="ActiveModeText" Text="STRICT MODE" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock x:Name="CountdownText" Text="00:50:00" FontSize="58" FontWeight="Black" HorizontalAlignment="Center" />
                                <TextBlock Text="SESSION REMAINING" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,7" />
                                <ProgressBar x:Name="BossHealthBar" Height="12" Minimum="0" Maximum="100" Value="100" />
                                <TextBlock x:Name="SessionSummaryText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,22" />
                                <TextBlock Text="Recently blocked" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="0,0,0,6" />
                                <ListBox x:Name="BlockedLogList" Height="125" />
                            </StackPanel>
                            <Button Grid.Row="2" x:Name="EndSessionButton" Content="End session early" Background="#2A1E23" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Click="EndSessionButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Progress &amp; settings">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Your focus, over time" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Background="{StaticResource CardAltBrush}" CornerRadius="16" Padding="18,13" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FOCUS" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="TotalFocusText" Text="0 min" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MISSIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="SessionsText" Text="0" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="XP" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="XpText" Text="0" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="STREAK" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="StreakText" Text="0 days" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <CheckBox x:Name="StartupCheckBox" Content="Start LOCK-IN with Windows" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                    <TextBlock Text="Progress stays on this Windows account. Strict Mode adds friction; Windows recovery remains available." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>