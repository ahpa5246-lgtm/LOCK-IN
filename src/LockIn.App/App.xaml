<Application x:Class="LockIn.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0E13"/>
        <SolidColorBrush x:Key="CardBrush" Color="#121720"/>
        <SolidColorBrush x:Key="CardAltBrush" Color="#171E29"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8D99AA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7CFFB2"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#253044"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0D1118"/>
            <Setter Property="BorderBrush" Value="#2A3547"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0B0E13"/>
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0D1118"/>
            <Setter Property="BorderBrush" Value="#2A3547"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>
    </Application.Resources>
</Application>
