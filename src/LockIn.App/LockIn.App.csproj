<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LockIn.App</RootNamespace>
    <AssemblyName>LOCK-IN</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Company>LOCK-IN</Company>
    <Product>LOCK-IN</Product>
    <Description>A local-first Windows focus application.</Description>
    <RepositoryUrl>https://github.com/ahpa5246-lgtm/LOCK-IN</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LockIn.Core\LockIn.Core.csproj" />
  </ItemGroup>
</Project>
